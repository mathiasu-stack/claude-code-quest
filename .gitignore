deploy.sh

# Local-only backup of pre-optimization character GLBs.
# Source of truth for scripts/optimize-characters.sh — keep on disk,
# but ~274 MB of binaries that should never be committed.
play/assets/characters/_originals/

# Same pattern for the Meshy decoration GLBs (desk, chair, plant, …).
# Pre-optimization sources ~44 MB; keep local, ship only optimized files.
play/assets/decorations/_originals/

# Synology DSM auto-creates @eaDir folders next to user files to hold
# extended-attribute / thumbnail sidecars (filename suffix @SynoEAStream).
# We don't want those in the repo.
**/@eaDir/

# Raw Meshy character uploads (space-named, ~130 MB) — duplicates of the
# underscore-named optimized rigs. Any filename with a space in this dir
# is a raw upload, never a shipped asset.
play/assets/characters/* *

# Blender working files + the 137 MB unprocessed Hijabi source — local
# only, would exceed GitHub's 100 MB hard limit and break the push.
play/assets/characters/Blender/
play/assets/characters/Hijabi_Professional_Arab_female.glb

# Client error-telemetry log written by save_server.py /errlog.
logs/

# Claude Code session state (agent worktrees etc.).
.claude/

# Python bytecode cache from gen scripts.
__pycache__/

# Neural TTS — secret key + per-line audio cache (never commit)
tts_config.json
tts-cache/

# Generated offline-play zip (scripts/build-offline-package.sh). Rebuilt
# from tracked files on demand — not committed, just served from disk by
# save_server.py for the in-app "Download for offline" link.
downloads/
